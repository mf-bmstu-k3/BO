/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off NewTryDiplomaMaster -c NewTryDiplomaMaster --vector_source="C:/intelFPGA_lite/20.1/test_for_bo.vwf" --testbench_file="C:/intelFPGA_lite/20.1/simulation/qsim/test_for_bo.vwf.vht"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off NewTryDiplomaMaster -c NewTryDiplomaMaster --vector_source="C:/intelFPGA_lite/20.1/test_for_bo.vwf" --testbench_file="C:/intelFPGA_lite/20.1/simulation/qsim/test_for_bo.vwf.vht"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=vhdl --output_directory="C:/intelFPGA_lite/20.1/simulation/qsim/" NewTryDiplomaMaster -c NewTryDiplomaMaster</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=vhdl --output_directory="C:/intelFPGA_lite/20.1/simulation/qsim/" NewTryDiplomaMaster -c NewTryDiplomaMaster</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vcom -work work NewTryDiplomaMaster.vho
vcom -work work test_for_bo.vwf.vht
vsim  -c -t 1ps -L cycloneiv -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.blok_oper_sch2_vhd_vec_tst
vcd file -direction NewTryDiplomaMaster.msim.vcd
vcd add -internal blok_oper_sch2_vhd_vec_tst/*
vcd add -internal blok_oper_sch2_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f




</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vcom -work work NewTryDiplomaMaster.vho
vcom -work work test_for_bo.vwf.vht
vsim -novopt -c -t 1ps -sdfmax blok_oper_sch2_vhd_vec_tst/i1=NewTryDiplomaMaster_vhd.sdo -L cycloneiv -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.blok_oper_sch2_vhd_vec_tst
vcd file -direction NewTryDiplomaMaster.msim.vcd
vcd add -internal blok_oper_sch2_vhd_vec_tst/*
vcd add -internal blok_oper_sch2_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f




</modelsim_script_timing>
<hdl_lang>vhdl</hdl_lang>
</simulation_settings>*/

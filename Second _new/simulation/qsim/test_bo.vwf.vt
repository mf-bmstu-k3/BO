`timescale 1 ps/ 1 ps
module blok_oper_vlg_sample_tst(
	a,
	b,
	clk,
	y,
	sampler_tx
);
input [3:0] a;
input [3:0] b;
input  clk;
input [10:1] y;
output sampler_tx;

reg sample;
time current_time;
always @(a or b or clk or y)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule


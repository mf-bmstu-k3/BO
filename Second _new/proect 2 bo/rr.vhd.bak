library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_ARITH.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;

---- Uncomment the following library declaration if instantiating
---- any Xilinx primitives in this code.
--library UNISIM;
--use UNISIM.VComponents.all;

entity rr is
generic (n:integer:=4);     -- n параметр, задает разрядность операндов
    Port ( d : in  STD_LOGIC_VECTOR (2*n-1 downto 0);-- сумма
           l : in  STD_LOGIC;   -- разрешение загрузки
           ce : in  STD_LOGIC; -- разрешение тактирования
           clk : in  STD_LOGIC; -- синхросигнал
           r : in  STD_LOGIC; -- вход очистки
           q : out  STD_LOGIC_VECTOR (2*n-1 downto 0));
end rr;

architecture Behavioral of rr is


signal state:STD_LOGIC_VECTOR (2*n-1 downto 0);
begin
process (clk)
begin
	if clk'event and clk='1' then	-- по положительному фронту синхросигнала
		if r='1' then state<=(others=>'0');   --очистка rr
		elsif (ce='1') then -- если есть разрешение тактирования
			if l='1' then state<=d;--загрузка rr
				else state<=state(2*n-2 downto 0)& state(2*n-1);-- циклический сдвиг влево rr
			end if;
		end if;
	end if;
end process;
q<= state;
end Behavioral;

